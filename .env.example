# Cấu hình kết nối Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# Mô hình LLM chính (Khuyên dùng qwen2.5:3b cho RTX 2050 4GB)
LLM_MODEL=qwen2.5:3b

# Mô hình nhúng Vector cho RAG (bge-m3 hoặc nomic-embed-text)
EMBEDDING_MODEL=bge-m3

# Cấu hình phân đoạn văn bản (RAG Chunking)
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Số đoạn văn bản ngữ cảnh lấy ra khi truy vấn RAG
TOP_K=3
